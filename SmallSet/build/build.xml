<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project basedir="." default="build" name="SmallSet">
	<property name="java.home" value="${env.JAVA_HOME}" />
	<property name="target" value="26" />
	<property name="source" value="26" />
	<!-- The name of the module is the same as that of the package. -->
	<property name="module" value="ch.claude_martin.smallset" />
	<property name="destdir" value="../bin/${module}" />

	<path id="junit">
		<!-- 
		Tests require JUnit5. But the standalone is not a module.
		Therefore, we have to add "junit-platform-console-standalone-*.jar" to the classpath. 
		-->
		<fileset dir="../lib" includes="*.jar" />
	</path>

	<path id="modulepath">
		<pathelement location="../bin" />
	</path>

	<path id="testpath">
		<path refid="junit" />
		<pathelement location="${destdir}" />
	</path>

	<target name="info">
		<echo>Module name: ${module}</echo>
		<echo>ANT version: ${ant.version}</echo>
		<echo>Java/JVM version: ${ant.java.version}</echo>
		<echo>Java/JVM detail version: ${java.version}</echo>
		<echo>Java home: ${java.home}</echo>
	</target>

	<target name="clean">
		<delete dir="${module}" />
		<mkdir dir="${destdir}" />
		<mkdir dir="../lib" />
	</target>

	<target name="compile" depends="info,clean">
		<javac debug="true" destdir="${destdir}" includeantruntime="false" source="${source}" target="${target}" fork="true">
			<compilerarg value="-J-Duser.language=en" />
			<compilerarg value="-J-Duser.country=US" />
			<src path="../src" />
			<compilerarg value="--enable-preview" />
		</javac>
	</target>

	<target name="test-compile" depends="compile">
		<!-- "junit-platform-console-standalone" is not a module and so we simply don't use modules to run junit. -->
		<delete file="${destdir}/module-info.class" />
		<javac modulepathref="modulepath" classpathref="junit" debug="true" destdir="${destdir}" includeantruntime="false" source="${source}" target="${target}">
			<src path="../test" />
			<compilerarg value="--enable-preview" />
		</javac>
	</target>

	<target name="build" depends="compile">
		<tstamp>
			<format property="TIME" pattern="yyyy-MM-dd-HH-mm-ss" locale="en,GB" />
		</tstamp>
		<jar jarfile="${module}.jar" basedir="${destdir}">
			<manifest>
				<attribute name="Manifest-Version" value="1.0" />
				<attribute name="Built-By" value="Claude Martin" />
				<attribute name="Sealed" value="true" />
				<attribute name="Implementation-Time" value="${TIME}" />
				<attribute name="Implementation-Title" value="${ant.project.name}" />
				<attribute name="Implementation-Vendor" value="Claude Martin" />
				<attribute name="Implementation-Vendor-URL" value="https://claude-martin.ch/" />
			</manifest>
		</jar>
	</target>

	<target name="javadoc">
		<javadoc access="public" author="true" destdir="./doc" encoding="UTF-8" charset="UTF-8" nodeprecated="true" nodeprecatedlist="true" noindex="true" nonavbar="false" notree="true" source="23" 
			  use="true" version="true" additionalparam="-Xdoclint:none"
			  header="project home: &lt;a target=&quot;_blank&quot; style=&quot;text-transform:lowercase;&quot; href=&quot;https://github.com/claudemartin/smallset/&quot;&gt;https://github.com/claudemartin/smallset/&lt;/a&gt;">
			<link href="https://docs.oracle.com/en/java/javase/${source}/docs/api/" />
			<arg value="--enable-preview" />
			<!-- sourcepath="../src" packagenames="ch.claude_martin.smallset"  -->
			<fileset dir="../src" casesensitive="yes">
				<include name="**/*.java" />
			</fileset>
		</javadoc>
	</target>

	<target name="test" depends="test-compile">
		<java classpathref="testpath" classname="org.junit.platform.console.ConsoleLauncher" fork="true" failonerror="true">
			<jvmarg value="--enable-preview" />
			<arg value="--select-package=${module}" />
			<arg value="--fail-if-no-tests" />
			<arg value="--reports-dir=reports" />
		</java>
	</target>

	<target name="demo" depends="test-compile">
		<java classpathref="testpath" classname="${module}.Demo" fork="true" failonerror="true">
			<jvmarg value="--enable-preview" />
		</java>
	</target>

</project>
